{
  "name": "blog-site",
  "private": true,
  "author": "alextheman",
  "description": "The true successor to Neurosongs, allowing users to write blogs and share them, with a dynamic editor to help with in-line images/audio/files in general.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build-alex-c-line-config": "tsdown",
    "dev": "turbo run dev",
    "format": "pnpm run format-package-json && pnpm run format-workspaces",
    "format-package-json": "eslint --fix --suppress-all \"./**/package.json\" && rm -f eslint-suppressions.json",
    "format-workspaces": "bash -c 'turbo run format $@' --",
    "lint": "pnpm run lint-package-json && pnpm run lint-workspaces",
    "lint-package-json": "eslint \"./**/package.json\"",
    "lint-workspaces": "bash -c 'turbo run lint $@' --",
    "pre-commit": "alex-c-line pre-commit-2",
    "prepare": "husky",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "devDependencies": {
    "@alextheman/eslint-plugin": "^5.7.0",
    "alex-c-line": "^1.27.0",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "tsdown": "<0.20.0"
    },
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ],
    "patchedDependencies": {
      "eslint-plugin-react": "patches/eslint-plugin-react.patch"
    }
  }
}
