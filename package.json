{
  "name": "lexicon",
  "private": true,
  "author": "alextheman",
  "description": "The true successor to Neurosongs, allowing users to write blogs and share them, with a dynamic editor.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build-alex-c-line-config": "tsdown",
    "dev": "turbo run dev",
    "format": "pnpm run format-package-json && pnpm run format-yml && pnpm run format-workspaces",
    "format-package-json": "eslint --fix --suppress-all \"**/package.json\" && rm -f eslint-suppressions.json",
    "format-workspaces": "bash -c 'turbo run format $@' --",
    "format-yml": "prettier --write \"**/*.{yml,yaml}\"",
    "lint": "pnpm run lint-package-json && pnpm run lint-yml && pnpm run lint-workspaces",
    "lint-package-json": "eslint \"**/package.json\"",
    "lint-workspaces": "bash -c 'turbo run lint $@' --",
    "lint-yml": "prettier --check \"**/*.{yml,yaml}\"",
    "pre-commit": "alex-c-line pre-commit",
    "prepare": "husky",
    "test": "turbo run test",
    "update-dependencies": "turbo run update-dependencies && pnpm update --latest && pnpm update"
  },
  "devDependencies": {
    "@alextheman/eslint-plugin": "5.14.0",
    "@faker-js/faker": "10.4.0",
    "@typescript-eslint/utils": "8.59.2",
    "alex-c-line": "2.7.2",
    "cross-env": "10.1.0",
    "eslint": "10.3.0",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "turbo": "2.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@alextheman/utility": "5.18.1",
    "@lexical/react": "0.44.0",
    "lexical": "0.44.0",
    "zod": "4.4.3"
  }
}
