{
  "name": "lexicon",
  "private": true,
  "author": "alextheman",
  "description": "The true successor to Neurosongs, allowing users to write blogs and share them, with a dynamic editor.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build-alex-c-line-config": "tsdown",
    "dev": "turbo run dev",
    "format": "pnpm run format-package-json && pnpm run format-yml && pnpm run format-workspaces",
    "format-package-json": "eslint --fix --suppress-all \"**/package.json\" && rm -f eslint-suppressions.json",
    "format-workspaces": "bash -c 'turbo run format $@' --",
    "format-yml": "prettier --write \"**/*.{yml,yaml}\"",
    "lint": "pnpm run lint-package-json && pnpm run lint-yml && pnpm run lint-workspaces",
    "lint-package-json": "eslint \"**/package.json\"",
    "lint-workspaces": "bash -c 'turbo run lint $@' --",
    "lint-yml": "prettier --check \"**/*.{yml,yaml}\"",
    "pre-commit": "alex-c-line pre-commit",
    "prepare": "husky",
    "test": "turbo run test",
    "update-dependencies": "turbo run update-dependencies && pnpm update --latest && pnpm update"
  },
  "devDependencies": {
    "@alextheman/eslint-plugin": "5.13.0",
    "@faker-js/faker": "10.4.0",
    "@typescript-eslint/utils": "8.58.2",
    "alex-c-line": "2.7.0",
    "cross-env": "10.1.0",
    "eslint": "10.2.1",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "turbo": "2.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "eslint-plugin-react": "patches/eslint-plugin-react.patch"
    }
  },
  "dependencies": {
    "@alextheman/utility": "5.11.2",
    "@lexical/react": "0.43.0",
    "lexical": "0.43.0",
    "zod": "4.3.6"
  }
}
