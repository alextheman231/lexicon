{
  "name": "lexicon",
  "private": true,
  "description": "The true successor to Neurosongs, allowing users to write blogs and share them, with a dynamic editor.",
  "author": "alextheman",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build-alex-c-line-config": "tsdown",
    "build-apps": "pnpm run build --filter=!@lexicon/**",
    "build-packages": "pnpm run build --filter=@lexicon/**",
    "build-static": "pnpm --dir packages/cli run dev build-static",
    "dev": "turbo run dev --filter=!@lexicon/cli",
    "format": "pnpm run format-package-json && pnpm run format-oxfmt && pnpm run format-workspaces",
    "format-oxfmt": "oxfmt \"*.json\" \"**/*.{yml,yaml}\"",
    "format-package-json": "eslint --fix --suppress-all \"**/package.json\" && rm -f eslint-suppressions.json",
    "format-workspaces": "bash -c 'turbo run format $@' --",
    "lint": "pnpm run lint-package-json && pnpm run lint-oxfmt && pnpm run lint-workspaces",
    "lint-oxfmt": "oxfmt --check \"*.json\" \"**/*.{yml,yaml}\"",
    "lint-package-json": "eslint \"**/package.json\"",
    "lint-workspaces": "bash -c 'turbo run lint $@' --",
    "pre-commit": "alex-c-line pre-commit",
    "prepare": "husky",
    "start": "pnpm run build-static && pnpm --dir apps/back-end run start",
    "test": "turbo run test --filter=!end-to-end",
    "test-end-to-end": "turbo run test --filter=end-to-end",
    "update-dependencies": "turbo run update-dependencies && pnpm update --latest && pnpm update"
  },
  "dependencies": {
    "@alextheman/utility": "5.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@alextheman/eslint-plugin": "5.18.9",
    "@faker-js/faker": "10.6.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/utils": "8.72.1",
    "alex-c-line": "2.17.3",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "oxfmt": "0.78.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
