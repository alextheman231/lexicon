{
  "name": "lexicon",
  "private": true,
  "author": "alextheman",
  "description": "The true successor to Neurosongs, allowing users to write blogs and share them, with a dynamic editor.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build-alex-c-line-config": "tsdown",
    "dev": "turbo run dev",
    "format": "pnpm run format-package-json && pnpm run format-workspaces",
    "format-package-json": "eslint --fix --suppress-all \"**/package.json\" && rm -f eslint-suppressions.json",
    "format-workspaces": "bash -c 'turbo run format $@' --",
    "lint": "pnpm run lint-package-json && pnpm run lint-workspaces",
    "lint-package-json": "eslint \"**/package.json\"",
    "lint-workspaces": "bash -c 'turbo run lint $@' --",
    "pre-commit": "alex-c-line pre-commit",
    "prepare": "husky",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "devDependencies": {
    "@alextheman/eslint-plugin": "^5.10.1",
    "alex-c-line": "^2.0.1",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.14",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ],
    "patchedDependencies": {
      "eslint-plugin-react": "patches/eslint-plugin-react.patch"
    }
  },
  "dependencies": {
    "@alextheman/utility": "^5.6.1",
    "@lexical/react": "^0.41.0",
    "lexical": "^0.41.0",
    "zod": "^4.3.6"
  }
}
