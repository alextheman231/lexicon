{
  "name": "end-to-end",
  "version": "1.0.0",
  "description": "End-to-end tests for Lexicon",
  "license": "ISC",
  "author": "alextheman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheman231/lexicon.git"
  },
  "files": [
    "tests"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "scripts": {
    "format": "pnpm run format-oxfmt && pnpm run format-eslint",
    "format-eslint": "eslint --fix --suppress-all \"tests/**/*.{ts,tsx}\" && rm -f eslint-suppressions.json",
    "format-oxfmt": "oxfmt \"**/*.{ts,js,json}\"",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-oxfmt",
    "lint-eslint": "eslint \"tests/**/*.{ts,tsx}\"",
    "lint-oxfmt": "oxfmt --check \"**/*.{ts,tsx,js,json}\"",
    "lint-tsc": "tsc --noEmit",
    "show-report": "playwright show-report",
    "show-trace": "playwright show-trace",
    "test": "tsx tests/setup.ts && playwright test",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "devDependencies": {
    "@lexicon/configs": "workspace:*",
    "@playwright/test": "1.65.0",
    "dotenv": "18.0.9",
    "execa": "10.2.1",
    "playwright": "1.65.0",
    "tsx": "4.23.15"
  }
}
