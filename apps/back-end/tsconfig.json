{
  "extends": ["../../tsconfig.json"],
  "references": [
    { "path": "../../packages/models" }
  ],
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ES2024"],
    "types": ["eslint", "node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "paths": {
      "src/*": ["./src/*"],
      "tests/*": ["./tests/*"],
      "factory/*": ["./factory/*"],
      "factory": ["./factory"]
    },
    "esModuleInterop": true,

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true
  },
  "include": ["src", "tests", "drizzle.config.ts", "vitest.config.ts", "factory"],
  "exclude": ["dist"]
}
