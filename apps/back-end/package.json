{
  "name": "back-end",
  "version": "1.0.0",
  "description": "The back-end server for Lexicon",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "nodemon src/server/index.ts",
    "end-test-db": "docker compose -f docker-compose.test.yml down",
    "format": "pnpm run format-prettier && pnpm run format-eslint",
    "format-eslint": "eslint --fix --suppress-all \"{src,tests}/**/*.ts\" && rm -f eslint-suppressions.json",
    "format-prettier": "pnpm run format-prettier-typescript && pnpm run format-prettier-javascript",
    "format-prettier-javascript": "prettier --write \"**/*.js\"",
    "format-prettier-typescript": "prettier --write --parser typescript \"**/*.ts\"",
    "generate-migration": "drizzle-kit generate",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-prettier",
    "lint-eslint": "eslint \"{src,tests}/**/*.ts\"",
    "lint-prettier": "pnpm run lint-prettier-typescript && pnpm run lint-prettier-javascript",
    "lint-prettier-javascript": "prettier --check \"**/*.js\"",
    "lint-prettier-typescript": "prettier --check --parser typescript \"**/*.ts\"",
    "lint-tsc": "tsc --noEmit",
    "migrate-db": "drizzle-kit migrate",
    "recreate-db": "pnpm run reset-db && pnpm run migrate-db",
    "reset-db": "dropdb --if-exists lexicon_dev && createdb lexicon_dev",
    "start": "node dist/index.js",
    "start-test-db": "docker compose -f docker-compose.test.yml up -d && cross-env NODE_ENV=test pnpm run migrate-db",
    "test": "vitest --run",
    "test-debug": "cross-env DEBUG=true pnpm test",
    "test-watch": "vitest",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "author": "alextheman",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "10.4.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.1",
    "@types/node": "25.5.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "drizzle-kit": "0.31.10",
    "execa": "9.6.1",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  },
  "dependencies": {
    "@lexicon/models": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "pg": "8.20.0"
  }
}
