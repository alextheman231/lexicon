{
  "name": "back-end",
  "version": "1.0.0",
  "description": "The back-end server for Lexicon",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "nodemon src/server/index.ts",
    "format": "pnpm run format-prettier && pnpm run format-eslint",
    "format-eslint": "eslint --fix --suppress-all \"src/**/*.{ts,tsx}\" && rm -f eslint-suppressions.json",
    "format-prettier": "pnpm run format-prettier-typescript && pnpm run format-prettier-javascript",
    "format-prettier-javascript": "prettier --write \"./**/*.js\"",
    "format-prettier-typescript": "prettier --write --parser typescript \"./**/*.{ts,tsx}\"",
    "generate-migration": "turbo run build --filter=@lexicon/schema --ui=stream && drizzle-kit generate",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-prettier",
    "lint-eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint-prettier": "pnpm run lint-prettier-typescript && pnpm run lint-prettier-javascript",
    "lint-prettier-javascript": "prettier --check \"./**/*.js\"",
    "lint-prettier-typescript": "prettier --check --parser typescript \"./**/*.{ts,tsx}\"",
    "lint-tsc": "tsc --noEmit",
    "migrate-db": "drizzle-kit migrate",
    "recreate-db": "pnpm run reset-db && pnpm run migrate-db",
    "reset-db": "dropdb --if-exists lexicon_dev && createdb lexicon_dev",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test-watch": "vitest"
  },
  "author": "alextheman",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "nodemon": "^3.1.14",
    "tsdown": "^0.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@lexicon/schema": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "pg": "^8.20.0"
  }
}
