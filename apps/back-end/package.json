{
  "name": "back-end",
  "version": "1.0.0",
  "description": "The back-end server for Lexicon",
  "license": "ISC",
  "author": "alextheman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheman231/lexicon.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "index.js",
  "scripts": {
    "build": "tsdown",
    "dev": "nodemon src/server/index.ts",
    "end-test-db": "docker compose -f docker-compose.test.yml down",
    "format": "pnpm run format-oxfmt && pnpm run format-prettier-sql && pnpm run format-eslint",
    "format-eslint": "eslint --fix --suppress-all \"{src,tests,factory,dev}/**/*.ts\" && rm -f eslint-suppressions.json",
    "format-oxfmt": "oxfmt \"**/*.{ts,js,json}\"",
    "format-prettier-sql": "prettier --write \"**/*.sql\"",
    "generate-migration": "drizzle-kit generate",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-oxfmt && pnpm run lint-prettier-sql",
    "lint-eslint": "eslint \"{src,tests,factory,dev}/**/*.ts\"",
    "lint-oxfmt": "oxfmt --check \"**/*.{ts,js,json}\"",
    "lint-prettier-sql": "prettier --check \"**/*.sql\"",
    "lint-tsc": "tsc --noEmit",
    "migrate-db": "tsx src/database/migrate.ts",
    "recreate-db": "pnpm run reset-db && pnpm run migrate-db && pnpm run seed-db",
    "recreate-docker-test-db": "docker compose -f docker-compose.test.yml down && pnpm run start-test-db",
    "recreate-end-to-end-db": "pnpm run reset-end-to-end-db && NODE_ENV=end-to-end pnpm run migrate-db && NODE_ENV=end-to-end pnpm run seed-db",
    "recreate-test-db": "pnpm run reset-test-db && cross-env NODE_ENV=test pnpm run migrate-db",
    "reset-db": "dropdb --if-exists lexicon_dev && createdb lexicon_dev",
    "reset-end-to-end-db": "dropdb --if-exists lexicon_end_to_end && createdb lexicon_end_to_end",
    "reset-test-db": "dropdb --if-exists lexicon_test && createdb lexicon_test",
    "seed-db": "tsx dev/data.ts",
    "start": "node dist/server/index.js",
    "start-docker-test-db": "docker compose -f docker-compose.test.yml up -d && cross-env NODE_ENV=test pnpm run migrate-db",
    "start-end-to-end": "NODE_ENV=end-to-end node dist/server/index.js",
    "test": "vitest --run",
    "test-debug": "cross-env DEBUG=true pnpm test",
    "test-watch": "vitest",
    "update-dependencies": "pnpm update --latest && pnpm update",
    "workers": "node dist/workers/index.js",
    "workers-dev": "nodemon src/workers/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@lexicon/models": "workspace:*",
    "@sentry/node": "11.11.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "multer": "2.5.0",
    "node-cron": "4.6.0",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "rate-limit-redis": "6.0.2",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@lexicon/configs": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "execa": "10.2.1",
    "nodemon": "3.1.14",
    "prettier": "3.10.1",
    "prettier-plugin-sql": "0.20.0",
    "supertest": "7.3.2",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
