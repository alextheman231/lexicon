{
  "name": "front-end",
  "version": "0.0.0",
  "private": true,
  "description": "The front-end for the new blog-site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheman231/lexicon.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "pnpm run format-oxfmt && pnpm run format-eslint",
    "format-eslint": "eslint --fix --suppress-all \"src/**/*.{ts,tsx}\" && rm -f eslint-suppressions.json",
    "format-oxfmt": "oxfmt \"**/*.{ts,tsx,js,json}\"",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-oxfmt",
    "lint-eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint-oxfmt": "oxfmt --check \"**/*.{ts,tsx,js,json}\"",
    "lint-tsc": "tsc --noEmit",
    "preview": "vite preview",
    "start-end-to-end": "NODE_ENV=end-to-end VITE_API_BASE_URL=http://localhost:9090 vite",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "dependencies": {
    "@alextheman/components": "7.12.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/inter": "5.3.0",
    "@lexical/react": "0.53.0",
    "@lexicon/models": "workspace:*",
    "@mui/material": "9.5.0",
    "@mui/utils": "9.5.0",
    "@sentry/react": "11.11.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-store": "0.11.2",
    "axios": "1.21.0",
    "lexical": "0.53.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-icons": "5.7.0",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@lexicon/configs": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
