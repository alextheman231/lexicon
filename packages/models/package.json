{
  "name": "@lexicon/models",
  "version": "1.0.0",
  "description": "Models to be used in all areas of Lexicon.",
  "license": "ISC",
  "author": "alextheman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheman231/lexicon.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "pnpm run format-oxfmt && pnpm run format-eslint",
    "format-eslint": "eslint --fix --suppress-all \"src/**/*.{ts,tsx}\" && rm -f eslint-suppressions.json",
    "format-oxfmt": "oxfmt \"**/*.{js,json,ts}\"",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-oxfmt",
    "lint-eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint-oxfmt": "oxfmt --check \"**/*.{js,json,ts}\"",
    "lint-prettier": "pnpm run lint-prettier-typescript && pnpm run lint-prettier-javascript",
    "lint-prettier-javascript": "prettier --check \"./**/*.{js,json}\"",
    "lint-prettier-typescript": "prettier --check --parser typescript \"./**/*.{ts,tsx}\"",
    "lint-tsc": "tsc --noEmit",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "dependencies": {
    "lexical": "0.53.0"
  },
  "devDependencies": {
    "tsdown": "0.23.7"
  }
}
