{
  "name": "@lexicon/cli",
  "version": "1.0.0",
  "description": "A CLI to carry out common dev tooling commands.",
  "license": "ISC",
  "author": "alextheman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheman231/lexicon.git"
  },
  "bin": {
    "lexicon": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "index.js",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli/index.ts",
    "format": "pnpm run format-oxfmt && pnpm run format-eslint",
    "format-eslint": "eslint --fix --suppress-all \"src/**/*.{ts,tsx}\" && rm -f eslint-suppressions.json",
    "format-oxfmt": "oxfmt \"**/*.{ts,js,json}\"",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-oxfmt",
    "lint-eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint-oxfmt": "oxfmt --check \"**/*.{ts,js,json}\"",
    "lint-tsc": "tsc --noEmit",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "dependencies": {
    "commander": "15.1.0",
    "execa": "10.2.1"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "15.1.0",
    "tsdown": "0.23.7",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
