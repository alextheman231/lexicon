{
  "name": "@lexicon/configs",
  "version": "1.0.0",
  "description": "Shared configs throughout Lexicon",
  "license": "ISC",
  "author": "alextheman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheman231/lexicon.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "pnpm run format-oxfmt && pnpm run format-eslint",
    "format-eslint": "eslint --fix --suppress-all \"src/**/*.{ts,tsx}\" && rm -f eslint-suppressions.json",
    "format-oxfmt": "oxfmt \"**/*.{ts,js,json}\"",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-oxfmt",
    "lint-eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint-oxfmt": "oxfmt --check \"**/*.{ts,js,json}\"",
    "lint-tsc": "tsc --noEmit",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "devDependencies": {
    "eslint-plugin-perfectionist": "5.13.0",
    "tsdown": "0.23.7"
  },
  "peerDependencies": {
    "@alextheman/eslint-plugin": ">=5.16.0",
    "eslint": ">=10.2.1",
    "eslint-plugin-perfectionist": ">=5.9.0"
  }
}
